# ============================================================
# JOB SEARCH AGENT — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Anthropic API ---
# Get this from: https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Google OAuth2 ---
# Set up at: https://console.cloud.google.com
# Enable: Gmail API, Google Calendar API, Google Sheets API
# Create OAuth2 credentials → Desktop App
# Then run: node src/auth.js to generate tokens
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# These are generated by running: node src/auth.js
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# --- Your Details ---
YOUR_EMAIL=your-email@gmail.com
YOUR_NAME=Your Name

# --- Google Sheets Pipeline Tracker ---
# Create a Google Sheet with columns:
# Company | Role | Status | Applied Date | Last Contact | Next Action | Notes | Match Score
# Paste the Sheet ID from the URL: /spreadsheets/d/SHEET_ID/edit
PIPELINE_SHEET_ID=your-google-sheet-id
PIPELINE_SHEET_TAB=Pipeline

# --- Job Monitoring RSS Feeds ---
# LinkedIn job alert RSS: set up a job alert on LinkedIn → copy the RSS URL from alert settings
# Indeed RSS: https://www.indeed.com/rss?q=senior+engineering+manager&l=Atlanta+GA
# Wellfound: https://wellfound.com/jobs.rss?role=engineering-manager
LINKEDIN_RSS_URL=https://www.linkedin.com/jobs/search/rss/?keywords=senior+engineering+manager
INDEED_RSS_URL=https://www.indeed.com/rss?q=senior+engineering+manager&l=remote
WELLFOUND_RSS_URL=

# --- Schedule (cron syntax) ---
# Default: 7:00 AM daily
DIGEST_SCHEDULE=0 7 * * *
# Default: every 4 hours
MONITOR_SCHEDULE=0 */4 * * *

# --- Dry Run ---
# Set to "true" to print output to console instead of sending emails
DRY_RUN=false
