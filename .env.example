# ============================================================
# JOB SEARCH AGENT — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Anthropic API ---
# Get this from: https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Google OAuth2 ---
# Set up at: https://console.cloud.google.com
# Enable: Gmail API, Google Calendar API, Google Sheets API
# Create OAuth2 credentials → Desktop App
# Then run: node src/auth.js to generate tokens
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# These are generated by running: node src/auth.js
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# --- Your Details ---
YOUR_EMAIL=your-email@gmail.com
YOUR_NAME=Jane Smith

# --- Google Sheets Pipeline Tracker ---
# Create a Google Sheet with these columns in row 1:
# Company | Role | Status | Applied Date | Last Contact | Next Action | Notes | Match Score | Ethics Flag
# Also create a second tab named "Seen" (for persisting job IDs across restarts) — leave it blank initially
# Paste the Sheet ID from the URL: /spreadsheets/d/SHEET_ID/edit
PIPELINE_SHEET_ID=your-google-sheet-id
PIPELINE_SHEET_TAB=Pipeline

# --- LinkedIn Job Search Configuration ---
# Uses LinkedIn's public job board — no account or login required.

# LINKEDIN_QUERIES: JSON array of search queries
# Format: [{"query":"Job Title","location":"Country or City"},...]
# Example: [{"query":"Senior Engineering Manager","location":"United States"}]
# ⚠️ Keep this in .env only — never commit to git
LINKEDIN_QUERIES=

# Optional: Configure search behavior (defaults shown)
LINKEDIN_LIMIT=25                                    # Jobs per query
LINKEDIN_REQUEST_DELAY_MS=500                        # Milliseconds between HTTP requests (higher = more polite)
LINKEDIN_TIME_FILTER=DAY                             # DAY|WEEK|MONTH|ANY — only fetch jobs from this period
LINKEDIN_EXPERIENCE_LEVEL=MID_SENIOR,DIRECTOR        # INTERNSHIP|ENTRY_LEVEL|ASSOCIATE|MID_SENIOR|DIRECTOR
LINKEDIN_REMOTE=REMOTE,HYBRID                        # ON_SITE|REMOTE|HYBRID

# --- Dry Run ---
# Set to "true" to print output to console instead of sending emails
DRY_RUN=false
