{
  "name": "job-search-agent",
  "version": "1.0.0",
  "description": "Automated job search assistant — daily digest, opportunity monitoring, email drafting",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "digest": "node src/index.js --job=digest",
